# Copy to apps/web/.env.local. All values are public (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# From `pnpm db:status` (PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Either the standalone API (`pnpm --filter @jarvis/api dev`)…
NEXT_PUBLIC_API_URL=http://localhost:4000
# …or the API served by this app under /api (as on Vercel). Then also set the
# server-side API settings here (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# AI_PROVIDERS, provider keys; see the root .env.example).
# NEXT_PUBLIC_API_URL=/api
