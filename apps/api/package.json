{
  "name": "@jarvis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e:server": "tsx test/e2e-server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@jarvis/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.23",
    "jose": "^6.2.18",
    "zod": "^4.6.7",
    "@jarvis/ai": "workspace:*"
  },
  "devDependencies": {
    "@jarvis/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2"
  }
}
