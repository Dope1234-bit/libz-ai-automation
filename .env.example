# Copy to `.env` (root) or `apps/<app>/.env` and fill in. Never commit real values.
# Values marked [secret] must only ever live in local .env files or the hosting
# provider's secret store.

# --- API service (apps/api) ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated browser origins allowed to call the API.
WEB_ORIGINS=http://localhost:3000

# --- Supabase (printed by `pnpm db:start` for local development) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=            # public, safe for the browser
# SUPABASE_SERVICE_ROLE_KEY=    # [secret] server-only, bypasses RLS — never expose to the web app

# --- AI providers (Milestone 1.2) — free tiers, any subset may be configured ---
# GOOGLE_GENERATIVE_AI_API_KEY= # [secret] Google AI Studio (Gemini) free tier
# GROQ_API_KEY=                 # [secret] Groq free tier
# OPENROUTER_API_KEY=           # [secret] OpenRouter free models
# OLLAMA_BASE_URL=http://127.0.0.1:11434  # local models, no key required
