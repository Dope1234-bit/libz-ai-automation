# Copy to `apps/api/.env` and fill in. Never commit real values.
# Values marked [secret] must only ever live in local .env files or the hosting
# provider's secret store.

# --- API service (apps/api) ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated browser origins allowed to call the API.
WEB_ORIGINS=http://localhost:3000

# --- Supabase ---
# For local development, run `pnpm db:start`, then `pnpm db:status` and copy
# API_URL and PUBLISHABLE_KEY here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# The secret / service-role key bypasses row-level security. The API does not use
# it; it is only needed to run integration tests (`pnpm test:integration`).
# SUPABASE_SECRET_KEY=          # [secret]

# --- AI providers — free tiers; list enabled ones in preference order ---
# Leave empty to run without AI (chat endpoints return 503).
AI_PROVIDERS=
# GOOGLE_GENERATIVE_AI_API_KEY= # [secret] Google AI Studio (Gemini), for "gemini"
# GROQ_API_KEY=                 # [secret] Groq, for "groq"
# OPENROUTER_API_KEY=           # [secret] OpenRouter, for "openrouter"
# OLLAMA_BASE_URL=http://127.0.0.1:11434  # for "ollama"; local models, no key
# Set to true when a managed egress proxy injects provider keys instead.
# AI_KEYS_VIA_PROXY=false
# Optional model overrides per provider and task (chat | fast), e.g.:
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- AI limits ---
# AI_DAILY_TOKEN_LIMIT=200000    # per user per UTC day, all workspaces
# AI_MAX_OUTPUT_TOKENS=2048
# AI_HISTORY_CHARS=24000         # conversation history sent per request
# AI_REQUESTS_PER_MINUTE=20      # chat requests per user
